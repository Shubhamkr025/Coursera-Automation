{
  "manifest_version": 3,
  "name": "Course Autopilot",
  "version": "1.0.0",
  "description": "Complete Coursera automation — videos, readings, quizzes — start to finish in one click",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "clipboardWrite"],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://*.coursera.org/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.coursera.org/*", "https://*.coursera.org/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://www.coursera.org/*", "https://*.coursera.org/*"],
      "js": ["injector.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": ["https://www.coursera.org/*", "https://*.coursera.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["claude_bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt_bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["main.js"],
      "matches": ["https://www.coursera.org/*", "https://*.coursera.org/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
